    \u0441 \u0432\u043E\u0441\u0441\u0442\u0430\u0432\u0448\u0438\u043C\u0438 \u043C\u0435\u0440\u0442\u0432\u0435\u0446\u0430\u043C\u0438
    \u0432 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F\u0445. \u0413\u043B\u0430\u0432\u043D\u0430\u044F
    \u0437\u0430\u0434\u0430\u0447\u0430 \u0438\u0433\u0440\u043E\u043A\u0430 - \u043F\u0440\u043E\u0439\u0442\u0438
    \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u043B\u044C\u0448\u0435
    \u0434\u043E \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u0442\u0435\u043C\u043D\u044B\u0445
    \u0441\u0438\u043B. \n\u041F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F
    \u043E\u043A\u0443\u0442\u0430\u043D\u044B \u0442\u044C\u043C\u043E\u0439, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u0441\u0438\u043B\u0430 \u0440\u0430\u0441\u0441\u0443\u0434\u043A\u0430 \u043C\u0435\u0440\u043A\u043D\u0435\u0442.
    \u041D\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0433\u0435\u0440\u043E\u044F
    \u043C\u043E\u0433\u0443\u0442 \u0441\u043F\u0430\u0441\u0442\u0438 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043F\u043B\u0438\u0442\u044B \u0441 \u0433\u043E\u043B\u0443\u0431\u044B\u043C
    \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435\u043C. \u0412\u043E\u0437\u043B\u0435
    \u043D\u0438\u0445 \u0441\u0438\u043B\u0430 \u0440\u0430\u0441\u0441\u0443\u0434\u043A\u0430
    \u043D\u0435 \u043F\u0430\u0434\u0430\u0435\u0442. \u041D\u043E \u0435\u0441\u043B\u0438
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0440\u0430\u0441\u0441\u0443\u0434\u043A\u0430
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043D\u0438\u0437\u043E\u043A,
    \u0442\u043E \u0438\u0433\u0440\u043E\u043A \u043D\u0430\u0447\u043D\u0451\u0442
    \u0442\u0435\u0440\u044F\u0442\u044C \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435,
    \u043B\u0438\u0431\u043E \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u0447\u0442\u043E-\u0442\u043E
    \u0445\u0443\u0436\u0435.\n\u041F\u043E\u0434\u0432\u043E\u0434\u044F \u0438\u0442\u043E\u0433,
    \u0433\u043B\u0430\u0432\u043D\u043E\u0435:\n1. \u0421\u043B\u0435\u0434\u0438
    \u0437\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\u043C \u0438 \u0443\u0440\u043E\u0432\u043D\u0435\u043C
    \u0440\u0430\u0441\u0441\u0443\u0434\u043A\u0430 (\u043A\u0440\u0430\u0441\u043D\u044B\u0439
    \u0438 \u0441\u0438\u043D\u0438\u0439 \u0438\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440\u044B).\n2.
    \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C
    \u043F\u0430\u0442\u0440\u043E\u043D\u043E\u0432 (\u0441\u043B\u0435\u0432\u0430
    \u0441\u043D\u0438\u0437\u0443).\n3. \u041F\u043E\u043B\u0443\u0447\u0430\u0439
    \u0437\u0430 \u0432\u0440\u0430\u0433\u043E\u0432 \u0441\u0432\u0435\u0442\u043B\u044B
    (\u0441\u0447\u0451\u0442\u0447\u0438\u043A \u0441\u043B\u0435\u0432\u0430 \u0441\u0432\u0435\u0440\u0445\u0443).\n4.
    \u0412\u0440\u0430\u0433\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430 \u0432 \u0433\u043E\u043B\u043E\u0432\u0443.\n5.
    \u0421\u0442\u0440\u0435\u043B\u043A\u0430 \u0441\u0432\u0435\u0440\u0445\u0443
    \u0443\u043A\u0430\u0436\u0435\u0442 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043F\u0443\u0442\u0438.\n6. \u041F\u0440\u043E\u0431\u0438\u0440\u0430\u0439\u0441\u044F
    \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0434\u0430\u043B\u044C\u0448\u0435."
