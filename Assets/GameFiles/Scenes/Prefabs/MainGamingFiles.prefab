  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u0430\u0448\u0430 \u043F\u0441\u0438-\u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C
    (\u0437\u043D\u0430\u0447\u043E\u043A \u043C\u043E\u0437\u0433\u0430 \u0441\u043F\u0440\u0430\u0432\u0430
    \u0432\u043D\u0438\u0437\u0443) \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C
    \u0434\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F \u0431\u0435\u0437\u0443\u043C\u0438\u044F.
    \u0427\u0442\u043E\u0431\u044B \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0435\u0435, \u0437\u0430\u0439\u0434\u0438\u0442\u0435 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0433\u043E\u043B\u0443\u0431\u044B\u0445
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u0435\u0447\u0430\u0442\u0435\u0439.\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
    Enter, \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u043A\u0440\u044B\u0442\u044C
    \u044D\u0442\u043E \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435."
